{
    "name": "russellw/tadmor-php",
    "description": "The PHP counterpart of tadmor: business management software on Laravel.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-pdo_pgsql": "*",
        "laravel/framework": "13.33.0"
    },
    "require-dev": {
        "phpunit/phpunit": "12.5.36"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "8.4.24"
        },
        "sort-packages": true,
        "lock": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
